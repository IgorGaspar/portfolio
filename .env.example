# Server-only variables. Never prefix any of these with NEXT_PUBLIC_.

# Anthropic API key used by the agent Route Handler (app/api/agent/route.ts)
ANTHROPIC_API_KEY=
# Model used by the agent. Swap for claude-haiku-4-5 to lower cost.
ANTHROPIC_MODEL=claude-opus-5-5

# Upstash Redis for rate limiting. Leave empty in dev to use the in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Agent rate limit per IP
AGENT_RATE_LIMIT_MAX=20
AGENT_RATE_LIMIT_WINDOW="1 h"
