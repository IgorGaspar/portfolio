# Server-only variables. Never prefix any of these with NEXT_PUBLIC_.

# Anthropic API key used by the agent Route Handler (app/api/agent/route.ts)
ANTHROPIC_API_KEY=
# Model used by the agent. Swap for claude-haiku-4-5 to lower cost.
ANTHROPIC_MODEL=claude-haiku-4-5

# Agent rate limit per IP (kept in process memory; resets when the container restarts)
AGENT_RATE_LIMIT_MAX=20
AGENT_RATE_LIMIT_WINDOW="1 h"

# Site-wide ceiling of agent calls per UTC day, across all visitors. Past it the agent
# answers "unavailable" and points to e-mail. Protects the API bill if the per-IP limit is bypassed. Also in memory.
AGENT_DAILY_LIMIT=200

# "staging" on the staging deploy (develop branch): every response gets noindex and robots.txt
# blocks everything. Read at build time, so set it as a build variable too. Leave empty in production.
SITE_ENV=
